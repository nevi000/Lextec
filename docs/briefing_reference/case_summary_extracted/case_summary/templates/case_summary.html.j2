{#- templates/case_summary.html.j2 — Fallzusammenfassung (case_summary_v1), Design 2
    Werte-Objekt pro Feld: {"v": Wert, "src": "doc|user|confirmed|derived", "ref": "Fundstelle", "confirmed": bool} oder null (= fehlt). -#}
{%- set ACTION_LABEL = {"PROCEED": "Weiterfahren", "ASK": "Rückfragen", "ESCALATE": "An Fachperson", "IMMEDIATE_SAFETY_RESPONSE": "Sofortmassnahme"} -%}
{%- set TL_LABEL = {"ROT": "Rot", "AMBER": "Orange", "GRUEN": "Grün"} -%}
{%- macro src(f) -%}
  {%- if f.src == 'doc' %}{{ f.ref or 'Unterlage' }}{% elif f.src == 'user' %}Angabe{% elif f.src == 'confirmed' %}bestätigt{% elif f.src == 'derived' %}berechnet{% endif -%}
{%- endmacro -%}
{%- macro field(label, f, wide=false) -%}
  <div class="kv{% if wide %} wide{% endif %}">
    <div class="k">{{ label }}</div>
    {%- if f is none or f.v is none or f.v == "" %}
    <div class="v missing">Fehlt</div>
    {%- else %}
    <div class="v">{{ f.v }}</div>
    <div class="s{% if f.src == 'doc' and not f.get('confirmed') %} open{% endif %}">{{ src(f) }}</div>
    {%- endif %}
  </div>
{%- endmacro -%}
{%- macro joined(a, b, sep=" / ") -%}
  {%- if a and b and a.v and b.v -%}{"v": a.v ~ sep ~ b.v, "src": a.src, "ref": a.ref, "confirmed": a.get('confirmed')}{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>Fallzusammenfassung {{ case.case_id }}</title>
<style>
  @page { size: A4; margin: 13mm 15mm 14mm 15mm; }
  :root {
    --ink: #1d1d1f; --ink-2: #424245; --muted: #6e6e73; --faint: #86868b;
    --hair: #d2d2d7; --hair-2: #e8e8ed; --surface: #f5f5f7;
    --red: #d70015; --red-tint: #fff1f0; --orange: #c93400; --orange-lamp: #ff9f0a; --orange-tint: #fff6eb;
    --green: #248a3d; --green-tint: #effaf2; --blue: #0066cc; --off: #e3e3e8;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #fff; }
  body { font-family: "Inter", sans-serif; color: var(--ink); font-size: 8pt; line-height: 1.38;
         font-feature-settings: "cv11", "ss01", "tnum"; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .display { font-family: "Inter Display", "Inter", sans-serif; }
  p { margin: 0; }
  .page { break-after: page; }
  .page:last-child { break-after: auto; }

  /* ---------- Kopf ---------- */
  .masthead { display: flex; justify-content: space-between; align-items: baseline; color: var(--faint); font-size: 7.2pt; margin-bottom: 4.6mm; }
  .masthead b { color: var(--ink); font-weight: 600; letter-spacing: -0.01em; }
  .sample { color: var(--red); font-weight: 600; }
  .hero { display: grid; grid-template-columns: 1fr 50mm; gap: 8mm; align-items: start; margin-bottom: 4.4mm; }
  .eyebrow-free { color: var(--muted); font-size: 8.4pt; margin-bottom: 1.2mm; }
  h1 { font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 19pt; line-height: 1.07; letter-spacing: -0.024em; margin: 0 0 1.6mm; }
  .who { font-size: 10pt; color: var(--ink-2); }
  .who span { color: var(--faint); }
  .stand { color: var(--faint); font-size: 7.2pt; margin-top: 1.2mm; }

  /* Ampel: die eine laute Stelle */
  .signal { border-radius: 14px; padding: 3.2mm 3.8mm 3mm; }
  .signal.ROT { background: var(--red-tint); }
  .signal.AMBER { background: var(--orange-tint); }
  .signal.GRUEN { background: var(--green-tint); }
  .lights { display: inline-flex; gap: 1.6mm; background: #1d1d1f; border-radius: 99px; padding: 1.4mm 2mm; margin-bottom: 2.6mm; }
  .light { width: 4.2mm; height: 4.2mm; border-radius: 50%; background: #3a3a3c; }
  .light.on.ROT { background: #ff453a; box-shadow: 0 0 0 0.6mm rgba(255,69,58,.28); }
  .light.on.AMBER { background: var(--orange-lamp); box-shadow: 0 0 0 0.6mm rgba(255,159,10,.28); }
  .light.on.GRUEN { background: #30d158; box-shadow: 0 0 0 0.6mm rgba(48,209,88,.28); }
  .signal-level { font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 15pt; line-height: 1; letter-spacing: -0.02em; }
  .signal.ROT .signal-level { color: var(--red); } .signal.AMBER .signal-level { color: var(--orange); } .signal.GRUEN .signal-level { color: var(--green); }
  .signal-label { font-weight: 600; font-size: 8.6pt; margin-top: 1mm; }
  .signal-why { color: var(--ink-2); font-size: 7.4pt; margin-top: 1.6mm; line-height: 1.38; }
  .signal-why .more { color: var(--muted); }

  .lead { font-size: 8.5pt; line-height: 1.42; color: var(--ink-2); margin: 0 0 4mm; }
  /* ---------- Kennzahlen-Band ---------- */
  .glance { display: grid; grid-template-columns: 1fr .9fr 1.3fr; background: var(--surface); border-radius: 12px; margin-bottom: 4.8mm; }
  .glance > div { padding: 2.6mm 3.8mm; }
  .glance > div + div { border-left: 1px solid var(--hair-2); }
  .g-k { color: var(--muted); font-size: 7.4pt; margin-bottom: 1mm; }
  .g-v { font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 16pt; line-height: 1.05; letter-spacing: -0.02em; }
  .g-v small { font-size: 9pt; font-weight: 600; letter-spacing: 0; color: var(--ink-2); }
  .g-v.hot { color: var(--red); }
  .g-d { color: var(--ink-2); font-size: 7.3pt; margin-top: 1mm; line-height: 1.33; }
  .g-d.note { color: var(--faint); font-size: 6.9pt; margin-top: 1mm; }

  /* ---------- Abschnitte ---------- */
  h2 { font-family: "Inter Display", sans-serif; font-weight: 650; font-size: 11pt; letter-spacing: -0.012em; margin: 0 0 2mm; }
  .section { margin-bottom: 4.2mm; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 9mm; }

  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .steps li { display: grid; grid-template-columns: 6.2mm 1fr; gap: 2.2mm; padding: 1.1mm 0; border-top: 1px solid var(--hair-2); counter-increment: s; }
  .steps li:first-child { border-top: none; padding-top: 0; }
  .steps li::before { content: counter(s); font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 9pt; color: #fff; background: var(--ink);
                      width: 5.2mm; height: 5.2mm; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: .2mm; }
  .steps b { font-weight: 600; font-size: 8.2pt; margin-right: 1.4mm; }
  .steps span { color: var(--ink-2); }

  .orgs { list-style: none; margin: 0; padding: 0; }
  .orgs li { padding: 1.3mm 0; border-top: 1px solid var(--hair-2); }
  .orgs li:first-child { border-top: none; padding-top: 0; }
  .orgs b { font-weight: 600; display: block; }
  .orgs .c { color: var(--ink-2); }
  .orgs .w { color: var(--muted); }
  .bodies { width: 100%; border-collapse: collapse; }
  .bodies td { padding: .9mm 3mm .9mm 0; border-top: 1px solid var(--hair-2); vertical-align: top; }
  .bodies tr:first-child td { border-top: none; padding-top: 0; }
  .bodies .name { font-weight: 600; width: 44%; }
  .bodies .contact { color: var(--ink-2); width: 21%; }
  .bodies .why { color: var(--muted); }
  .dot { display: inline-block; width: 1.6mm; height: 1.6mm; border-radius: 50%; background: var(--orange-lamp); margin-left: 1.2mm; vertical-align: 0.3mm; }

  .facts { display: grid; grid-template-columns: 1fr 1fr; column-gap: 9mm; }
  .kv { display: grid; grid-template-columns: 24mm 1fr auto; gap: 2mm; padding: .62mm 0; border-top: 1px solid var(--hair-2); align-items: baseline; }
  .kv:first-of-type { border-top: none; }
  .k { color: var(--muted); }
  .v { font-weight: 500; }
  .s { color: var(--faint); font-size: 6.6pt; white-space: nowrap; text-align: right; }
  .s.open::before { content: ""; display: inline-block; width: 1.4mm; height: 1.4mm; border-radius: 50%; background: var(--orange-lamp); margin-right: 1.1mm; vertical-align: .2mm; }
  .missing { color: var(--red); font-weight: 600; }
  .unconf { display: inline-block; width: 1.6mm; height: 1.6mm; border-radius: 50%; background: var(--orange-lamp); margin-right: 1.4mm; vertical-align: 0.3mm; }

  .notice { display: grid; grid-template-columns: 2.4mm 1fr; gap: 2.6mm; padding: 1.8mm 3.2mm; border-radius: 10px; background: var(--orange-tint); margin-bottom: 4mm; font-size: 7.6pt; }
  .notice::before { content: ""; width: 2.2mm; height: 2.2mm; border-radius: 50%; background: var(--orange-lamp); margin-top: .7mm; }
  .notice.critical { background: var(--red-tint); }
  .notice.critical::before { background: var(--red); }
  .notice.hr { background: #f4f1fb; }
  .notice.hr::before { background: #8944ab; }
  .notice b { font-weight: 600; }
  .notice p { color: var(--ink-2); }

  h2 small.legend { font-family: "Inter", sans-serif; font-weight: 400; font-size: 6.8pt; color: var(--faint); letter-spacing: 0; margin-left: 2mm; }
  .footnote { color: var(--faint); font-size: 6.4pt; line-height: 1.4; margin-top: 2mm; border-top: 1px solid var(--hair-2); padding-top: 2.2mm; }

  /* ---------- Seite 2 ---------- */
  .page-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 5mm; }
  .page-head h1 { font-size: 15pt; margin: 0; }
  .page-head span { color: var(--faint); font-size: 7.4pt; }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline li { display: grid; grid-template-columns: 22mm 3.4mm 1fr auto; gap: 2.4mm; padding: 1.15mm 0; align-items: baseline; }
  .timeline .d { color: var(--muted); font-variant-numeric: tabular-nums; }
  .timeline .m { width: 2mm; height: 2mm; border-radius: 50%; border: 1.4px solid var(--ink); background: #fff; justify-self: center; align-self: center; }
  .timeline li.future .m { border-color: var(--red); background: var(--red); }
  .timeline li.weak .m { border-style: dashed; border-color: var(--faint); }
  .timeline .q { color: var(--faint); font-size: 6.8pt; text-align: right; }

  .checks { list-style: none; margin: 0; padding: 0; }
  .checks li { display: grid; grid-template-columns: 17mm 1fr 52mm; gap: 3mm; padding: 1.5mm 0; border-top: 1px solid var(--hair-2); align-items: baseline; }
  .checks li:first-child { border-top: none; padding-top: 0; }
  .state { font-weight: 600; font-size: 7.4pt; }
  .state::before { content: ""; display: inline-block; width: 1.8mm; height: 1.8mm; border-radius: 50%; margin-right: 1.4mm; vertical-align: 0.2mm; }
  .state.erfuellt { color: var(--green); } .state.erfuellt::before { background: var(--green); }
  .state.offen { color: var(--orange); } .state.offen::before { background: var(--orange-lamp); }
  .state.unklar { color: var(--red); } .state.unklar::before { background: var(--red); }
  .checks .b { color: var(--muted); font-size: 7.4pt; }

  .plain { margin: 0; padding: 0; list-style: none; }
  .plain li { padding: .9mm 0 .9mm 4mm; border-top: 1px solid var(--hair-2); position: relative; }
  .plain li:first-child { border-top: none; padding-top: 0; }
  .plain li::before { content: ""; position: absolute; left: 0; top: 2.85mm; width: 1.5mm; height: 1.5mm; border-radius: 50%; background: var(--hair); }
  .plain li:first-child::before { top: 1.65mm; }
  .plain.q li::before { border-radius: 1px; background: none; border: 1px solid var(--muted); width: 1.9mm; height: 1.9mm; top: 2.6mm; }
  .plain.q li:first-child::before { top: 1.4mm; }

  .sources { width: 100%; border-collapse: collapse; }
  .sources td { padding: 1.3mm 3mm 1.3mm 0; border-top: 1px solid var(--hair-2); }
  .sources tr:first-child td { border-top: none; }
  .sources .c { font-weight: 600; width: 38mm; }
  .sources .u { color: var(--muted); }
  .sources .ok { color: var(--green); font-weight: 600; font-size: 7.4pt; width: 22mm; text-align: right; }
  .sources .no { color: var(--orange); font-weight: 600; font-size: 7.4pt; width: 22mm; text-align: right; }

  .audit { background: var(--surface); border-radius: 10px; padding: 3mm 3.6mm; color: var(--muted); font-size: 7.2pt; }
  .audit b { color: var(--ink-2); font-weight: 600; }

  /* ---------- Anhang ---------- */
  .annex { break-before: page; }
  .docs { list-style: none; margin: 0; padding: 0; }
  .docs li { display: grid; grid-template-columns: 9mm 1fr 44mm; gap: 3mm; padding: 1.6mm 0; border-top: 1px solid var(--hair-2); }
  .docs li:first-child { border-top: none; }
  .docs .n { font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 10pt; }
  .docs .t { font-weight: 600; font-size: 9pt; }
  .docs .x { color: var(--muted); font-size: 7.4pt; margin-top: .6mm; }
  .docs .r { color: var(--muted); font-size: 7.4pt; text-align: right; }
  .docs li.absent .n, .docs li.absent .t { color: var(--red); }
  .scan-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 3mm; }
  .scan-head b { font-family: "Inter Display", sans-serif; font-size: 11pt; font-weight: 650; }
  .scan-head span { color: var(--faint); font-size: 7.4pt; }
  .scan { text-align: center; background: var(--surface); border-radius: 12px; padding: 5mm; }
  .scan img { max-width: 100%; max-height: 228mm; box-shadow: 0 0.4mm 2mm rgba(0,0,0,.12); }
  .wordmark { font-family: "Inter Display", sans-serif; font-weight: 800; font-size: 13pt; letter-spacing: -0.03em; color: var(--ink); }
  .logo { height: 7mm; width: auto; }
  .masthead { align-items: center; }
  .client { font-family: "Inter Display", sans-serif; font-weight: 650; font-size: 12pt; letter-spacing: -0.01em; margin-top: .4mm; }
  .contact-line { color: var(--ink-2); font-size: 8.4pt; margin-top: .8mm; }
  .contact-line span + span { margin-left: 4mm; }
  .g-name { font-family: "Inter Display", sans-serif; font-weight: 700; font-size: 11.5pt; line-height: 1.15; letter-spacing: -0.012em; }
  .g-list { list-style: none; margin: .6mm 0 0; padding: 0; }
  .g-list li { font-weight: 600; font-size: 8.4pt; line-height: 1.3; padding: .5mm 0 .5mm 3mm; position: relative; }
  .g-list li::before { content: ""; position: absolute; left: 0; top: 1.9mm; width: 1.5mm; height: 1.5mm; border-radius: 50%; background: var(--red); }
  .qa { list-style: none; margin: 0; padding: 0; }
  .qa li { padding: .9mm 0; border-top: 1px solid var(--hair-2); }
  .qa li:first-child { border-top: none; padding-top: 0; }
  .qa b { display: block; font-weight: 600; }
  .qa span { color: var(--ink-2); }
  .qa i { font-style: normal; color: var(--faint); font-size: 6.8pt; margin-left: 1.6mm; }
  .qa .pending { color: var(--orange); font-weight: 500; }
  .docs.compact li { padding: 1.6mm 0; }
</style>
</head>
<body>

<!-- ===================== SEITE 1: AUF EINEN BLICK ===================== -->
<section class="page">
  <div class="masthead">
    <span>Fallzusammenfassung für die Sachbearbeitung&emsp;Fall {{ case.case_id }}{% if case.is_sample %}&emsp;<span class="sample">Muster, fiktive Daten</span>{% endif %}</span>
    {% if logo %}<img class="logo" src="{{ logo }}" alt="LexTec">{% else %}<span class="wordmark">LexTec</span>{% endif %}
  </div>

  <div class="hero">
    <div>
      <h1>{{ case.issue_labels | join(" und ") }}</h1>
      <p class="client">{{ case.person.first_name.v if case.person.first_name else "" }} {{ case.person.last_name.v if case.person.last_name else "Name fehlt" }}</p>
      <p class="contact-line">
        {%- if case.person.phone %}<span>{{ case.person.phone.v }}</span>{% endif -%}
        {%- if case.person.email %}<span>{{ case.person.email.v }}</span>{% endif -%}
        {%- if case.person.address %}<span>{{ case.person.address.v }}</span>{% endif -%}
      </p>
      <p class="stand">Mietobjekt {{ case.tenancy.object_address.v if case.tenancy.object_address else "unbekannt" }}, Kanton {{ case.canton or "unbekannt" }}. Erstellt {{ case.created_at }}.</p>
    </div>
    <div class="signal {{ tl.level }}">
      <div class="lights">
        <span class="light {% if tl.level == 'ROT' %}on ROT{% endif %}"></span>
        <span class="light {% if tl.level == 'AMBER' %}on AMBER{% endif %}"></span>
        <span class="light {% if tl.level == 'GRUEN' %}on GRUEN{% endif %}"></span>
      </div>
      <div class="signal-level">{{ TL_LABEL[tl.level] }}</div>
      <div class="signal-label">{{ tl.label }}</div>
      <div class="signal-why">{{ tl.reasons[0] }}{% if tl.reasons | length > 1 %}<br><span class="more">{{ tl.reasons[1:] | map("replace", "zudem: ", "") | join(", ") }}</span>{% endif %}</div>
    </div>
  </div>

  {% for s in case.safety_flags %}
  <div class="notice {{ 'critical' if s.level in ['IMMEDIATE_SAFETY_RESPONSE', 'ESCALATE'] else '' }}">
    <p><b>{{ s.flag }}.</b> {{ s.detail }}{% if s.show_to_user %} Der Person angezeigt: {{ s.show_to_user | join(", ") }}.{% endif %}</p>
  </div>
  {% endfor %}
  {% if case.liability_flag %}
  <div class="notice hr">
    <p><b>Achtung: Mögliche Haftung der Behörde ({{ case.liability_flag.severity }}).</b> {{ case.liability_flag.categories | join(", ") }}. Vorgesetzte informiert: {{ case.liability_flag.supervisor_notified_at or "ausstehend" }}.</p>
  </div>
  {% endif %}

  <p class="lead">{{ case.short_summary }}</p>

  {% set primary = case.recommendation.responsible_bodies[0] if case.recommendation.responsible_bodies else none %}
  <div class="glance">
    <div>
      <div class="g-k">Nächste Frist</div>
      {% if dl %}
      <div class="g-v {% if dl.days_left is not none and dl.days_left <= 10 %}hot{% endif %}">{{ dl.days_left if dl.days_left is not none else "?" }} <small>Tage</small></div>
      <div class="g-d">{{ dl.label }} bis <b>{{ dl.computed_end }}</b>, rechnerisch</div>
      {% else %}<div class="g-v">Keine</div><div class="g-d">Keine Frist erkannt</div>{% endif %}
    </div>
    <div>
      <div class="g-k">Weiterleiten an</div>
      {% if primary %}
      <div class="g-name">{{ primary.label }}{% if not primary.verified %}<span class="dot" title="Kontakt noch zu bestätigen"></span>{% endif %}</div>
      <div class="g-d">{{ primary.contact or "Kontakt fehlt" }}</div>
      {% else %}<div class="g-name">Keine Stelle zugeordnet</div>{% endif %}
    </div>
    <div>
      {% set nmiss = case.missing_documents | length %}
      <div class="g-k">{% if nmiss %}Es fehlen{% else %}Unterlagen{% endif %}</div>
      {% if nmiss %}
      <ul class="g-list">{% for m in case.missing_documents %}<li>{{ m }}</li>{% endfor %}</ul>
      {% else %}<div class="g-v">Vollständig</div>{% endif %}
    </div>
  </div>

  <div class="facts section">
    <div>
      <h2>Person</h2>
      {{ field("Erreichbar", case.person.preferred_contact) }}
      {{ field("Geburtsdatum", case.person.birth_date) }}
      {{ field("Haushalt", case.person.household) }}
      {{ field("Sprache", {"v": (case.person.language.v ~ (", Dolmetsch nötig" if case.person.interpreter_needed and case.person.interpreter_needed.v == "ja" else ", kein Dolmetsch")), "src": "user"} if case.person.language else none) }}
      {{ field("Datenweitergabe", case.person.consent_data_sharing) }}
    </div>
    <div>
      <h2>Mietverhältnis <small class="legend"><span class="unconf"></span>gelesen, noch nicht bestätigt</small></h2>
      {{ field("Vermieterin", case.tenancy.landlord) }}
      {{ field("Objekt", case.tenancy.object_type) }}
      {{ field("Familienwohnung", case.tenancy.family_dwelling) }}
      {{ field("Mietbeginn", {"v": case.tenancy.contract_start.v ~ (" (" ~ case.tenancy.duration.v ~ ")" if case.tenancy.duration else ""), "src": case.tenancy.contract_start.src, "ref": case.tenancy.contract_start.ref, "confirmed": case.tenancy.contract_start.get("confirmed")} if case.tenancy.contract_start else none) }}
      {{ field("Befristung", case.tenancy.fixed_term) }}
      {{ field("Kündigung", case.tenancy.notice_period) }}
      {{ field("Mietzins", {"v": case.tenancy.rent_net.v ~ " + " ~ (case.tenancy.ancillary_costs.v | replace("CHF ", "")) ~ " NK" ~ (" = " ~ (case.tenancy.rent_gross.v | replace("CHF ", "")) if case.tenancy.rent_gross else ""), "src": case.tenancy.rent_net.src, "ref": case.tenancy.rent_net.ref} if case.tenancy.rent_net and case.tenancy.ancillary_costs else case.tenancy.rent_net) }}
      {{ field("Kaution", case.tenancy.deposit) }}
      {{ field("Referenzzins", case.tenancy.reference_rate) }}
    </div>
  </div>

  <div class="section">
    <h2>Prozess</h2>
    <ol class="steps">
    {% for s in case.recommendation.proposed_steps %}
      {% if s is mapping %}<li><div><b>{{ s.title }}.</b><span>{{ s.detail }}</span></div></li>
      {% else %}<li><div><span>{{ s }}</span></div></li>{% endif %}
    {% endfor %}
    </ol>
  </div>

  <div class="section">
    <h2>Zuständige Stellen <small class="legend"><span class="unconf"></span>Kontakt noch zu bestätigen</small></h2>
    <table class="bodies">
      {% for b in case.recommendation.responsible_bodies %}
      <tr><td class="name">{{ b.label }}{% if not b.verified %}<span class="dot" title="Kontakt noch zu bestätigen"></span>{% endif %}</td>
          <td class="contact">{{ b.contact or "Kontakt fehlt" }}</td><td class="why">{{ b.reason }}</td></tr>
      {% endfor %}
    </table>
  </div>
</section>

<!-- ===================== SEITE 2: UNTERLAGEN UND SACHVERHALT ===================== -->
<section class="page">
  <div class="masthead">
    <span>Fall {{ case.case_id }}{% if case.is_sample %}&emsp;<span class="sample">Muster, fiktive Daten</span>{% endif %}</span>
    {% if logo %}<img class="logo" src="{{ logo }}" alt="LexTec">{% else %}<span class="wordmark">LexTec</span>{% endif %}
  </div>

  <div class="section">
    <div class="page-head"><h1 class="display">Unterlagen</h1><span>{{ case.documents | length }} erhalten, {{ case.missing_documents | length }} fehlen. Scans ab Seite {{ annex_start_page + 1 }}.</span></div>
    <ul class="docs">
      {% for m in case.missing_documents %}
      <li class="absent"><span class="n">–</span><div class="t">{{ m }}</div><div class="r">Fehlt, angefordert am {{ case.as_of }}</div></li>
      {% endfor %}
      {% for d in case.documents %}
      <li><span class="n">{{ d.annex_no }}</span>
          <div><div class="t">{{ d.label }}</div><div class="x">Gelesen: {{ d.extracted | join(", ") }}</div></div>
          <div class="r">Eingang {{ d.received }}<br>Seiten: {{ d.pages }}, Lesequalität {{ d.ocr_quality }}</div></li>
      {% endfor %}
    </ul>
  </div>

  <div class="section">
    <h2>Chronologie</h2>
    <ul class="timeline">
      {% for e in case.chronology %}
      <li class="{% if loop.last %}future{% elif 'Angabe' in e.source %}weak{% endif %}">
        <span class="d">{{ e.date }}</span><span class="m"></span><span>{{ e.event }}</span><span class="q">{{ e.source }}</span></li>
      {% endfor %}
    </ul>
  </div>

  <div class="section">
    <h2>Rechtliche Prüfpunkte</h2>
    <ul class="checks">
      {% for c in case.legal_check %}
      <li><span class="state {{ c.status }}">{{ {"erfuellt":"Erfüllt","offen":"Offen","unklar":"Unklar"}[c.status] }}</span><span>{{ c.point }}</span><span class="b">{{ c.basis }}</span></li>
      {% endfor %}
    </ul>
  </div>

  <div class="split">
    <div class="section">
      <h2>Fragen und Antworten aus dem Gespräch</h2>
      <ul class="qa">
        {% for x in case.dialog %}
        <li class="{{ 'open' if not x.a else '' }}"><b>{{ x.q }}</b>
          {% if x.a %}<span>{{ x.a }}</span>{% if x.when %}<i>{{ x.when }}</i>{% endif %}
          {% else %}<span class="pending">Offen, im Erstgespräch klären</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    <div class="section">
      <h2>Lücken und Widersprüche</h2>
      <ul class="plain">{% for m in case.missing_and_contradictions %}<li>{{ m }}</li>{% endfor %}</ul>
    </div>
  </div>

</section>

<!-- ===================== ANHANG ===================== -->
<section class="annex">
  <div class="masthead">
    <span>Fall {{ case.case_id }}&emsp;Anhang{% if case.is_sample %}&emsp;<span class="sample">Muster, fiktive Daten</span>{% endif %}</span>
    {% if logo %}<img class="logo" src="{{ logo }}" alt="LexTec">{% else %}<span class="wordmark">LexTec</span>{% endif %}
  </div>
  <div class="page-head"><h1 class="display">Rechtsquellen</h1><span>Zitate gegen den Gesetzestext geprüft</span></div>
  <table class="sources">
    {% for s in case.legal_sources %}
    <tr><td class="c">{{ s.cite }}</td><td class="u">{{ s.used_for }}</td><td class="{{ 'ok' if s.verified else 'no' }}">{{ 'Geprüft' if s.verified else 'Ungeprüft' }}</td></tr>
    {% endfor %}
  </table>
  <div class="audit" style="margin-top:6mm">
    <b>Nachvollziehbarkeit.</b> Ausgelöste Regeln: {{ case.audit.rules_fired | join(", ") }}.
    Regelwerk {{ case.kb_version }}, {{ case.audit.model }}, verarbeitet {{ case.audit.processed_at }}.
    Die Ampel folgt festen Regeln, nicht dem Sprachmodell. Grau neben jedem Wert steht seine Herkunft; Fehlendes wird nie geschätzt.
    Die KI bereitet vor und entscheidet nicht; keine Rechtsberatung.
  </div>
</section>
{% for d in case.documents %}{% for img in d.images %}
<section class="annex">
  <div class="scan-head"><b>{{ d.annex_no }}&ensp;{{ d.label }}</b><span>Seite {{ loop.index }} von {{ d.images | length }}, Eingang {{ d.received }}</span></div>
  <div class="scan"><img src="{{ img }}" alt="Scan {{ d.label }}, Seite {{ loop.index }}"></div>
</section>
{% endfor %}{% endfor %}
</body>
</html>
