# Copy to `.env` (repo root). `.env` is gitignored - never commit real keys.

# "mock" works without credentials. "gemini" calls the external Google Gemini API (costs money).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# gemini-3.x thinking level. MINIMAL is rejected by gemini-3.8-flash (verified); LOW keeps reasoning cheap.
AI_THINKING_LEVEL=LOW

# --- cost control: APPLICATION limits enforced server-side before every request ---------------------
# They are NOT a guaranteed Google billing cap; also set a budget alert in Google AI Studio / Cloud billing.
AI_MAX_CALLS_PER_CASE=12
AI_MAX_INPUT_TOKENS_PER_CALL=8000
AI_MAX_OUTPUT_TOKENS_PER_CALL=2500
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=150000
AI_DAILY_BUDGET_USD=0.50
AI_CASE_BUDGET_USD=0.10
# Optional price override (USD per 1M tokens). Default: built-in official table for the model
# (gemini-3.8-flash: 0.75 in / 3.75 out until 2026-12-31, 1.50 / 7.50 from 2027-01-01; retrieved 2026-11-07).
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Optional: let Gemini reword follow-up questions (an extra paid call per decision; off by default).
AI_REPHRASE_QUESTIONS=false

# Reference date for "days since receipt". Default = today. Pin it for a reproducible demo:
# APP_TODAY=2026-11-07

APP_ENV=development
# Default: <repo>/data/lextec.db  (absolute path recommended if you override)
# DATABASE_URL=sqlite:///C:/path/to/lextec.db

# ---- Fedlex (official Swiss federal law; public, no API key) ---------------------------------------
# Used only by `python -m app.cli fedlex ...` and POST /api/sources/fedlex/sync. No LLM is involved and
# no case data is ever sent. The app itself reads the local cache only.
FEDLEX_ENABLED=true
FEDLEX_SPARQL_URL=https://fedlex.data.admin.ch/sparqlendpoint
FEDLEX_CACHE_ENABLED=true
# Cache entries older than this are shown as "Gespeicherte Fassung, möglicherweise veraltet"
FEDLEX_CACHE_MAX_AGE_DAYS=14
FEDLEX_TIMEOUT_SECONDS=15
FEDLEX_MAX_CONCURRENT_REQUESTS=2
FEDLEX_MIN_REQUEST_INTERVAL_SECONDS=0.5
FEDLEX_MAX_RETRIES=2
FEDLEX_MAX_RESPONSE_BYTES=25000000
FEDLEX_LANGUAGE=de
