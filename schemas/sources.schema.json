        },
        "relevant_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Relevant Fact Ids",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "title_de"
      ],
      "title": "SourceDef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "content_status": {
      "default": "DRAFT",
      "enum": [
        "DEMO_SYNTHETIC",
        "DRAFT",
        "LEGALLY_REVIEWED"
      ],
      "title": "Content Status",
      "type": "string"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceDef"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "version"
  ],
  "title": "SourcesFile",
  "type": "object"
}
