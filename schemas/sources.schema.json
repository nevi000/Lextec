          "type": "array"
        },
        "core_statement_de": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Core Statement De"
        },
        "scope_de": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope De"
        },
        "limits_de": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
