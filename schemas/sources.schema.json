{
  "$defs": {
    "SourceDef": {
      "additionalProperties": false,
      "description": "A legal source.\n\nTwo DIFFERENT statuses, never to be confused:\n* ``dossier_status``      - what the law team's dossier states (checked against their uploaded\n                             PDFs / full texts, or still pending, or only mentioned without text).\n* ``verification_status`` - live verification BY THIS SYSTEM (e.g. via Fedlex). Stays UNVERIFIED\n                             until such a mechanism really exists and ran.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "default": "fedlex",
          "enum": [
            "fedlex",
            "entscheidsuche",
            "bger",
            "other"
          ],
          "title": "Provider",
          "type": "string"
        },
        "type": {
          "default": "statute",
          "enum": [
            "statute",
            "case_law",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "sr_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sr Number"
        },
        "statute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statute"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article"
        },
        "paragraph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "language": {
          "default": "de",
          "title": "Language",
          "type": "string"
        },
        "title_de": {
          "title": "Title De",
          "type": "string"
        },
        "text_de": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text De"
        },
        "legal_question_de": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Question De"
        },
        "valid_as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
