    "Condition": {
      "additionalProperties": false,
      "description": "One node of a condition tree: either a composite (all/any/not) or a leaf (ref/op).",
      "properties": {
        "all": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "All"
        },
        "any": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Any"
        },
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "op": {
          "anyOf": [
            {
              "enum": [
                "equals",
                "not_equals",
                "in",
                "exists",
                "is_missing",
                "is_known",
                "greater_than",
                "less_than",
                "is_unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "DerivedDef": {
      "additionalProperties": false,
      "description": "A value computed by the engine from KNOWN date facts. Used for INTERNAL urgency assessment\nonly - never to state a deadline end date.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
